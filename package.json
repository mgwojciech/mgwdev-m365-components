{
  "name": "mgwdev-m365-components",
  "description": "React components and helpers for building SharePoint, Microsoft Graph, and Dataverse experiences in Microsoft 365 apps.",
  "private": false,
  "version": "0.1.2",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgwojciech/mgwdev-m365-components.git"
  },
  "homepage": "https://github.com/mgwojciech/mgwdev-m365-components",
  "bugs": {
    "url": "https://github.com/mgwojciech/mgwdev-m365-components/issues"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "build-lib": "gulp build",
    "test": "vitest",
    "test:report": "vitest --reporter=junit --outputFile.junit=./tests/TEST-mgwdev-m365-components.xml --watch=false",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "keywords": [
    "SharePoint",
    "MSGraph",
    "Microsoft 365",
    "microsoft-365",
    "Dataverse",
    "Dynamics",
    "React",
    "Graph",
    "Fluent UI",
    "Teams",
    "Copilot",
    "components",
    "library",
    "spfx",
    "enterprise"
  ],
  "author": "m.g.wojciechowski@gmail.com",
  "license": "MIT",
  "dependencies": {
    "@azure/msal-browser": "^5.9.0"
  },
  "peerDependencies": {
    "@fluentui/react-components": "^9.74.3",
    "mgwdev-m365-helpers": "^0.3.4",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.74.3",
    "@microsoft/rush-stack-compiler-4.7": "^0.1.0",
    "@microsoft/sp-build-web": "^1.21.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.0.0",
    "mgwdev-m365-helpers": "^0.3.6",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-dts": "^3.6.4",
    "vitest": "^1.6.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/mgwdev-m365-components.umd.js",
  "module": "./dist/mgwdev-m365-components.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/mgwdev-m365-components.es.js",
      "require": "./dist/mgwdev-m365-components.umd.js",
      "types": "./dist/index.d.ts"
    }
  }
}
